# Do not put this file inside the project folder. The commands read the terminal, not a .env file.
# Save a private copy outside the repo, for example ~/.hypergrok/ibkr.env
# Paper account ids look like DU0000000. Live stays off unless you opt in.
DESK_VENUE=ibkr
IBKR_GATEWAY_URL=https://localhost:5000
IBKR_ACCOUNT_ID=DU0000000
# IBKR_LIVE=1
# DESK_STATE_DIR=/workspace/trading-desk
