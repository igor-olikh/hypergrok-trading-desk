{
  "description": "HyperGrok: ask before any Bash command that looks like a Hyperliquid or IBKR order write",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/exchange_write_gate.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/ibkr_write_gate.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
